+std::string UIManager::ApplyXSLayout(const std::string& layout, int backend)
+{
+    // Refresh at click time: Virtual Desktop can change a monitor's mode during a session.
+    const auto monitors = XSGetMonitors();
+    const auto selected = std::find_if(monitors.begin(), monitors.end(), [&](const XSMonitor& m) { return m.ID == m_XSMonitorID; });
+    if (selected == monitors.end()) return "Selected monitor disconnected. Select a connected monitor.";
+    const int width = selected->Bounds.right - selected->Bounds.left;
+    const int height = selected->Bounds.bottom - selected->Bounds.top;
+    const auto cuts = XSCutPoints(width,layout);
+    if (cuts.empty()) return "Unknown layout or invalid monitor width.";
+    if (width < 4 || height < 1) return "Monitor has no usable desktop bounds.";
+    const bool append = layout.compare(0,4,"Add ") == 0;
+    const bool combined_ddp = backend == 0 && !ConfigManager::GetValue(configid_bool_performance_single_desktop_mirroring);
+    const POINT crop_origin = XSCropOrigin(selected->Bounds,selected->AdapterBounds,combined_ddp);
+    const int crop_x = crop_origin.x, crop_y = crop_origin.y;
+    const std::string name = "XS Auto D" + std::to_string(m_XSMonitorID+1) + " " + std::to_string(width) + "x" + std::to_string(height) + " " + layout + " B" + std::to_string(backend);
+    const std::wstring path = WStringConvertFromUTF8((ConfigManager::Get().GetApplicationPath() + "profiles/" + name + ".ini").c_str());
+    Ini config(path,true);
+    // Use a comfortable physical height at every source resolution; preserve crop aspect ratios.
+    const float physical_height = 0.70f;
+    const float total_width = physical_height * (cuts.back()-cuts.front()) / height;
+    float left = -(total_width + 0.03f*(cuts.size()-2)) / 2;
+    Matrix4 facing;
+    if (IsOpenVRLoaded()) facing = vr::IVRSystemEx::ComputeHMDFacingTransform(1.5f);
+    else { facing.identity(); facing.translate(0,1.4f,-1.5f); }
+    for (size_t i=0; i+1<cuts.size(); ++i)
+    {
+        const std::string section = "Overlay" + std::to_string(i);
+        const char* key = section.c_str();
+        const float panel_width = physical_height * (cuts[i+1]-cuts[i]) / height;
+        config.WriteString(key,"Name", ("XS " + layout + " " + std::to_string(i+1)).c_str());
+        config.WriteBool(key,"NameIsCustom",true); config.WriteBool(key,"Enabled",true);
+        config.WriteInt(key,"CaptureSource",backend); config.WriteInt(key,"DesktopID",m_XSMonitorID); config.WriteInt(key,"WinRTDesktopID",m_XSMonitorID);
+        config.WriteInt(key,"Width",std::max(1,(int)(panel_width*100))); config.WriteInt(key,"Curvature",0);
+        config.WriteInt(key,"Opacity",100); config.WriteInt(key,"DisplayMode",0); config.WriteString(key,"Origin","Room");
+        config.WriteBool(key,"TransformLocked",false); config.WriteBool(key,"CroppingEnabled",true);
+        config.WriteInt(key,"CroppingX",crop_x+cuts[i]); config.WriteInt(key,"CroppingY",crop_y);
+        config.WriteInt(key,"CroppingWidth",cuts[i+1]-cuts[i]); config.WriteInt(key,"CroppingHeight",height);
+        config.WriteBool(key,"InputEnabled",true); config.WriteBool(key,"InputDPlusLPEnabled",true);
+        config.WriteBool(key,"ShowFloatingUI",true); config.WriteBool(key,"ShowActionBar",false); config.WriteBool(key,"ShowDesktopButtons",false);
+        Matrix4 pose = facing; pose.translate_relative(left + panel_width/2,0,0);
+        config.WriteString(key,"Transform",pose.toString().c_str()); left += panel_width+0.03f;
+    }
+    if (!config.Save()) return "Could not write the monitor layout. Existing panels were kept.";
+    return LoadXSProfile(name,append);
+}
