+void UIManager::SaveXSPreferences()
+{
+    Ini preferences(WStringConvertFromUTF8((ConfigManager::Get().GetApplicationPath()+"xs-ui.ini").c_str()));
+    preferences.WriteInt("Wrist","WidthCM",(int)(m_XSWristWidth*100+0.5f));
+    preferences.WriteBool("Wrist","RightHand",m_XSWristRightHand);
+    preferences.WriteBool("Wrist","Enabled",m_XSWristEnabled);
+    if (!preferences.Save()) LOG_F(WARNING,"Could not save XS wrist preferences");
+}
