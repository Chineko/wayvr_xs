+std::string UIManager::LoadXSProfile(const std::string& profile, bool append)
+{
+    const std::wstring path = WStringConvertFromUTF8((ConfigManager::Get().GetApplicationPath() + "profiles/" + profile + ".ini").c_str());
+    if (!FileExists(path.c_str())) return "Profile missing. Extract the complete XS package.";
+    if (!append && OverlayManager::Get().GetOverlayCount() && !ConfigManager::Get().SaveMultiOverlayProfileToFile("XS Previous Layout.ini"))
+        return "Backup failed. Layout was not replaced.";
+    std::vector<char> included(1, true);
+    if (!ConfigManager::Get().LoadMultiOverlayProfileFromFile(profile + ".ini", !append, append ? &included : nullptr))
+        return "Could not load profile.";
+    ConfigManager::SetValue(configid_bool_state_overlay_dragmode, false);
+    IPCManager::Get().PostConfigMessageToDashboardApp(configid_bool_state_overlay_dragmode, false);
+    IPCManager::Get().SendStringToDashboardApp(configid_str_state_profile_name_load, profile, GetWindowHandle());
+    if (append)
+    {
+        IPCManager::Get().PostMessageToDashboardApp(ipcmsg_action, ipcact_overlay_profile_load, MAKELPARAM(ipcactv_ovrl_profile_multi_add, 0));
+        IPCManager::Get().PostMessageToDashboardApp(ipcmsg_action, ipcact_overlay_profile_load, MAKELPARAM(ipcactv_ovrl_profile_multi_add, -1));
+    }
+    else
+    {
+        IPCManager::Get().PostMessageToDashboardApp(ipcmsg_action, ipcact_overlay_profile_load, ipcactv_ovrl_profile_multi);
+        OnProfileLoaded();
+    }
+    RepeatFrame();
+    return "";
+}
