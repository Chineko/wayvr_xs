+constexpr const char* const k_pch_DesktopPlusVersion = (sizeof("" DPLUS_SHA) <= 1) ? "Desktop+ XS 0.1.0 (Desktop+ 3.6)" : "Desktop+ " DPLUS_SHA;
 
