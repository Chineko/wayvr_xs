+
+void UIManager::ProcessXSPanelClose()
+{
+    if (m_XSClosePanelHandle == vr::k_ulOverlayHandleInvalid) return;
+    const auto handle = m_XSClosePanelHandle; m_XSClosePanelHandle = vr::k_ulOverlayHandleInvalid;
+    for (unsigned int id=0; id<OverlayManager::Get().GetOverlayCount(); ++id)
+    {
+        if (OverlayManager::Get().GetConfigData(id).ConfigHandle[configid_handle_overlay_state_overlay_handle] != handle) continue;
+        m_FloatingUI.ResetTarget();
+        auto& properties = m_WindowOverlayProperties;
+        if (properties.GetActiveOverlayID() == id) { properties.SetActiveOverlayID(k_ulOverlayID_None,true); properties.HideAll(); }
+        else if (properties.GetActiveOverlayID() != k_ulOverlayID_None && properties.GetActiveOverlayID() > id)
+            properties.SetActiveOverlayID(properties.GetActiveOverlayID()-1,true);
+        OverlayManager::Get().RemoveOverlay(id);
+        IPCManager::Get().PostMessageToDashboardApp(ipcmsg_action,ipcact_overlay_remove,id);
+        RepeatFrame(); break;
+    }
+}
+
+void UIManager::ExitXS()
+{
+    // Same graceful exit path as the native tray Quit command. OnExit saves the
+    // workspace and releases held inputs; this never asks the VR runtime to quit.
+    SaveXSPreferences();
+    DisableRestartOnExit();
+    if (HWND window = ::FindWindow(g_WindowClassNameDashboardApp,nullptr))
+        ::PostMessage(window,WM_QUIT,0,0);
+    ::PostMessage(GetWindowHandle(),WM_QUIT,0,0);
+}
