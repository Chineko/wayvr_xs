@@ -6,6 +6,37 @@
 
 #include <vector>
 
+// Per-controller grip capture, independent of pointer hover and action-edge timing.
+struct XSGripEvent
+{
+    bool Changed = false;
+    bool Down = false;
+    vr::VROverlayHandle_t Target = vr::k_ulOverlayHandleInvalid;
+};
+
+struct XSGripCapture
+{
+    bool IsDown = false;
+    vr::VROverlayHandle_t Target = vr::k_ulOverlayHandleInvalid;
+
+    XSGripEvent Update(bool active, bool pressed, vr::VROverlayHandle_t candidate)
+    {
+        const bool down = active && pressed;
+        if (IsDown && !down)
+        {
+            const auto previous = Target;
+            IsDown = false; Target = vr::k_ulOverlayHandleInvalid;
+            return {true,false,previous};
+        }
+        if (!IsDown && down && candidate != vr::k_ulOverlayHandleInvalid)
+        {
+            IsDown = true; Target = candidate;
+            return {true,true,Target};
+        }
+        return {};
+    }
+};
+
 struct LaserPointerDevice
 {
     vr::VROverlayHandle_t OvrlHandle = vr::k_ulOverlayHandleInvalid;
@@ -20,7 +51,7 @@ struct LaserPointerDevice
