+void UIManager::UpdateXSWrist()
+{
+    static int shelf = 0;
+    static bool media = false;
+    static int backend = 0;
+    static std::string status;
+    static bool confirm_save = false;
+    static Win32PerformanceData perf;
+    static bool perf_active = false;
+    const bool visible = m_OvrlHandleXSWrist != vr::k_ulOverlayHandleInvalid && vr::VROverlay()->IsOverlayVisible(m_OvrlHandleXSWrist);
+    if (perf_active != (visible && shelf == 3))
+    {
+        perf_active = visible && shelf == 3;
+        if (perf_active) perf.EnableCounters(false); else perf.DisableCounters();
+    }
+    if (!visible) return;
+    const DPRect& rect = UITextureSpaces::Get().GetRect(ui_texspace_xs_wrist);
+    const ImVec2 origin((float)rect.Min.x, (float)rect.Min.y);
+    const ImU32 pale = IM_COL32(233,238,242,255), muted = IM_COL32(169,182,193,255);
+    ImGui::PushStyleColor(ImGuiCol_WindowBg, IM_COL32(32,39,46,255));
+    ImGui::PushStyleColor(ImGuiCol_Border, IM_COL32(57,67,76,255));
+    ImGui::PushStyleColor(ImGuiCol_Text, pale);
+    ImGui::PushStyleColor(ImGuiCol_TextDisabled, muted);
+    ImGui::PushStyleColor(ImGuiCol_Button, IM_COL32(21,28,34,255));
+    ImGui::PushStyleColor(ImGuiCol_ButtonHovered, IM_COL32(52,65,76,255));
+    ImGui::PushStyleColor(ImGuiCol_ButtonActive, IM_COL32(92,114,132,255));
+    ImGui::PushStyleColor(ImGuiCol_FrameBg, IM_COL32(21,28,34,255));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 20.0f);
+    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 12.0f);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(14,14));
+    ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(6,8));
+    const ImGuiWindowFlags flags = ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+        ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoCollapse;
+    auto card = [&](const char* name, float y, float height) {
+        ImGui::SetNextWindowPos(ImVec2(origin.x + 32, origin.y + y));
+        ImGui::SetNextWindowSize(ImVec2(520, height));
+        ImGui::Begin(name, nullptr, flags);
+        ImGui::SetWindowFontScale(0.70f);
+    };
+    auto select_backend = [&]() {
+        ImGui::SetNextItemWidth(-1);
+        ImGui::Combo("##XSWristCapture", &backend, "Graphics Capture\0Desktop Duplication\0");
+    };
+    auto load = [&](const char* layout, bool append) {
+        status = LoadXSProfile(std::string("XS 5120 ") + layout + " - " + (backend == 0 ? "Graphics Capture" : "Desktop Duplication"), append);
+    };
+    auto set_visible = [&](unsigned int id, bool enabled) {
+        OverlayManager::Get().GetConfigData(id).ConfigBool[configid_bool_overlay_enabled] = enabled;
+        IPCManager::Get().PostConfigMessageToDashboardApp(configid_int_state_overlay_current_id_override, (int)id);
+        IPCManager::Get().PostConfigMessageToDashboardApp(configid_bool_overlay_enabled, enabled);
+        IPCManager::Get().PostConfigMessageToDashboardApp(configid_int_state_overlay_current_id_override, -1);
+    };
+    if (shelf != 0)
+    {
+        card("##XSWristShelf", 32, 320);
+        const char* titles[] = {"", "PANELS / SETS", "SAVED LAYOUTS", "PC PERFORMANCE", "QUICK ACTIONS"};
+        ImGui::TextDisabled("%s", titles[shelf]);
+        ImGui::SameLine(452);
+        if (ImGui::Button("-##CloseShelf", ImVec2(36,32))) shelf = 0;
+        if (shelf == 1)
+        {
+            select_backend();
+            if (ImGui::Button("+ Full", ImVec2(152,40))) load("Add Full", true);
+            ImGui::SameLine(); if (ImGui::Button("+ Left", ImVec2(152,40))) load("Add Left Half", true);
+            ImGui::SameLine(); if (ImGui::Button("+ Right", ImVec2(152,40))) load("Add Right Half", true);
+            ImGui::BeginChild("##XSWristPanels", ImVec2(0,125), true);
+            const auto count = OverlayManager::Get().GetOverlayCount();
+            for (unsigned int i = 0; i < count; ++i)
+            {
+                ImGui::PushID((int)i);
+                auto& data = OverlayManager::Get().GetConfigData(i);
+                bool enabled = data.ConfigBool[configid_bool_overlay_enabled];
+                if (ImGui::Checkbox(data.ConfigNameStr.c_str(), &enabled)) set_visible(i, enabled);
+                ImGui::PopID();
+            }
+            if (count == 0) ImGui::TextDisabled("Add your first panel above.");
+            ImGui::EndChild();
+            ImGui::TextDisabled("Grip: move   Trigger: interact");
+        }
+        else if (shelf == 2)
+        {
+            select_backend();
+            if (ImGui::Button("Dual", ImVec2(152,40))) load("Dual", false);
+            ImGui::SameLine(); if (ImGui::Button("Thirds", ImVec2(152,40))) load("Thirds", false);
+            ImGui::SameLine(); if (ImGui::Button("Wide centre", ImVec2(152,40))) load("Wide Center", false);
+            if (ImGui::Button(confirm_save ? "Confirm replace wrist save" : "Save current as XS Wrist Saved", ImVec2(-1,40)))
+            {
+                const std::wstring saved = WStringConvertFromUTF8((ConfigManager::Get().GetApplicationPath() + "profiles/XS Wrist Saved.ini").c_str());
+                if (FileExists(saved.c_str()) && !confirm_save) confirm_save = true;
+                else { status = ConfigManager::Get().SaveMultiOverlayProfileToFile("XS Wrist Saved.ini") ? "Layout saved." : "Could not save layout."; confirm_save = false; }
+            }
+            if (ImGui::Button("Load wrist save", ImVec2(240,40))) status = LoadXSProfile("XS Wrist Saved", false);
+            ImGui::SameLine(); if (ImGui::Button("Undo layout switch", ImVec2(240,40)))
+            {
+                // Preserve the undo profile before LoadXSProfile writes a new backup.
+                const std::string folder = ConfigManager::Get().GetApplicationPath() + "profiles/";
+                const auto from = WStringConvertFromUTF8((folder + "XS Previous Layout.ini").c_str());
+                const auto to = WStringConvertFromUTF8((folder + "XS Wrist Undo.ini").c_str());
+                status = ::CopyFileW(from.c_str(), to.c_str(), FALSE) ? LoadXSProfile("XS Wrist Undo", false) : "No previous layout available.";
+            }
+            ImGui::TextWrapped("Layout buttons replace panels; your previous layout is backed up.");
+        }
+        else if (shelf == 3)
+        {
+            perf.Update();
+            ImGui::Text("CPU: %.0f%%", perf.GetCPULoadPrecentage());
+            ImGui::Text("RAM: %.1f / %.1f GB", perf.GetRAMUsedGB(), perf.GetRAMTotalGB());
+            vr::Compositor_FrameTiming timing = {}; timing.m_nSize = sizeof(timing);
+            if (vr::VRCompositor()->GetFrameTiming(&timing))
+            {
+                ImGui::Text("VR frame interval: %.2f ms", timing.m_flClientFrameIntervalMs);
+                ImGui::Text("VR app GPU: %.2f ms", timing.m_flTotalRenderGpuMs);
+                ImGui::Text("Compositor GPU: %.2f ms", timing.m_flCompositorRenderGpuMs);
+            }
+            else ImGui::TextDisabled("SteamVR frame timing unavailable");
+            ImGui::TextWrapped("Live SteamVR timings; system CPU and RAM. Counters stop when this shelf is hidden.");
+        }
+        else if (shelf == 4)
+        {
+            if (ImGui::Button("Keyboard", ImVec2(240,44))) m_VRKeyboard.GetWindow().Show();
+            ImGui::SameLine(); if (ImGui::Button("Settings", ImVec2(240,44))) m_WindowSettings.Show();
+            if (ImGui::Button("Use left wrist", ImVec2(240,44))) m_XSWristRightHand = false;
+            ImGui::SameLine(); if (ImGui::Button("Use right wrist", ImVec2(240,44))) m_XSWristRightHand = true;
+            if (ImGui::Button("Normal trigger interaction", ImVec2(-1,44)))
+            {
+                ConfigManager::SetValue(configid_bool_state_overlay_dragmode, false);
+                IPCManager::Get().PostConfigMessageToDashboardApp(configid_bool_state_overlay_dragmode, false);
+            }
+            ImGui::TextWrapped("Point with the opposite controller. Grip moves an unlocked panel; trigger clicks it. No Move mode or locking is needed.");
+        }
+        if (!status.empty()) ImGui::TextWrapped("%s", status.c_str());
+        ImGui::End();
+    }
+    card("##XSWristBase", 360, 176);
+    SYSTEMTIME local; ::GetLocalTime(&local);
+    const ULONGLONG seconds = ::GetTickCount64() / 1000;
+    static const ULONGLONG session_start = seconds;
+    ImGui::SetWindowFontScale(0.55f); ImGui::TextDisabled("W A Y V R  X S");
+    ImGui::SetWindowFontScale(1.18f); ImGui::Text("%02u:%02u", local.wHour, local.wMinute);
+    const char* labels[] = {"Panels", "Layouts", "PC", "Media", "Actions"};
+    for (int i = 0; i < 5; ++i)
+    {
+        ImGui::SetCursorPos(ImVec2(230.0f + i * 54, 18));
+        const bool active = i == 3 ? media : shelf == (i == 4 ? 4 : i + 1);
+        if (active) ImGui::PushStyleColor(ImGuiCol_Button, IM_COL32(213,226,235,255));
+        ImGui::PushID(i);
+        if (ImGui::Button("##ShelfIcon", ImVec2(48,54)))
+        {
+            if (i == 3) media = !media;
+            else { const int next = i == 4 ? 4 : i + 1; shelf = shelf == next ? 0 : next; confirm_save = false; }
+        }
+        if (active) ImGui::PopStyleColor();
+        if (ImGui::IsItemHovered()) ImGui::SetTooltip("%s", labels[i]);
+        const ImU32 ink = active ? IM_COL32(21,28,34,255) : pale;
+        const ImVec2 a = ImGui::GetItemRectMin();
+        ImDrawList* draw = ImGui::GetWindowDrawList();
+        auto point = [&](float x, float y) { return ImVec2(a.x+12+x, a.y+15+y); };
+        auto line = [&](float x, float y, float xx, float yy) { draw->AddLine(point(x,y), point(xx,yy), ink, 1.6f); };
+        if (i == 0) { draw->AddRect(point(4,4), point(20,20), ink, 2, 0, 1.6f); line(4,10,20,10); line(10,10,10,20); }
+        if (i == 1) { draw->AddRect(point(3,7), point(21,20), ink, 2, 0, 1.6f); line(3,7,3,5); line(3,5,10,5); line(10,5,12,7); }
+        if (i == 2) { line(5,20,5,11); line(12,20,12,4); line(19,20,19,8); }
+        if (i == 3) { line(9,18,9,5); line(9,5,19,3); line(19,3,19,16); draw->AddCircleFilled(point(6,18),3,ink); draw->AddCircleFilled(point(16,16),3,ink); }
+        if (i == 4) { line(3,6,21,6); line(3,12,21,12); line(3,18,21,18); draw->AddCircleFilled(point(8,6),2.5f,ink); draw->AddCircleFilled(point(16,12),2.5f,ink); draw->AddCircleFilled(point(10,18),2.5f,ink); }
+        ImGui::PopID();
+    }
+    ImGui::SetWindowFontScale(0.55f);
+    ImGui::SetCursorPos(ImVec2(18,86));
+    const auto elapsed = seconds - session_start;
+    ImGui::TextDisabled("%04u-%02u-%02u   Session %02llu:%02llu", local.wYear, local.wMonth, local.wDay, elapsed/3600, elapsed/60%60);
+    ImGui::SetCursorPos(ImVec2(14,122));
+    ImGui::GetWindowDrawList()->AddRectFilled(ImVec2(origin.x+46,origin.y+482), ImVec2(origin.x+538,origin.y+522), IM_COL32(21,28,34,255),12);
+    ImGui::SetCursorPos(ImVec2(26,130));
+    ImGui::Text("%u panels                                      SteamVR", OverlayManager::Get().GetOverlayCount());
+    ImGui::End();
+    float battery_y = 544;
+    if (media)
+    {
+        card("##XSWristMedia", 544, 90);
+        ImGui::TextDisabled("WINDOWS MEDIA");
+        const WORD keys[] = {VK_MEDIA_PREV_TRACK, VK_MEDIA_PLAY_PAUSE, VK_MEDIA_NEXT_TRACK};
+        const char* buttons[] = {"Previous", "Play / Pause", "Next"};
+        for (int i=0; i<3; ++i)
+        {
+            if (i) ImGui::SameLine();
+            if (ImGui::Button(buttons[i], ImVec2(156,36)))
+            {
+                INPUT inputs[2] = {}; inputs[0].type = inputs[1].type = INPUT_KEYBOARD;
+                inputs[0].ki.wVk = inputs[1].ki.wVk = keys[i]; inputs[1].ki.dwFlags = KEYEVENTF_KEYUP;
+                if (::SendInput(2, inputs, sizeof(INPUT)) != 2) status = "Windows rejected the media key.";
+            }
+        }
+        ImGui::End(); battery_y += 98;
+    }
+    // Runtime-reported batteries only. Omit absent values instead of showing fabricated levels.
+    struct Battery { std::string name; float charge; bool charging; };
+    static std::vector<Battery> batteries;
+    static ULONGLONG battery_tick = 0;
+    if (::GetTickCount64() - battery_tick >= 1000)
+    {
+        battery_tick = ::GetTickCount64(); batteries.clear();
+        for (uint32_t device=0; device<vr::k_unMaxTrackedDeviceCount; ++device)
+        {
+            if (!vr::VRSystem()->IsTrackedDeviceConnected(device)) continue;
+            vr::ETrackedPropertyError error;
+            if (!vr::VRSystem()->GetBoolTrackedDeviceProperty(device, vr::Prop_DeviceProvidesBatteryStatus_Bool, &error) || error != vr::TrackedProp_Success) continue;
+            const float charge = vr::VRSystem()->GetFloatTrackedDeviceProperty(device, vr::Prop_DeviceBatteryPercentage_Float, &error);
+            if (error != vr::TrackedProp_Success || charge < 0 || charge > 1) continue;
+            const auto role = vr::VRSystem()->GetControllerRoleForTrackedDeviceIndex(device);
+            const std::string name = device == vr::k_unTrackedDeviceIndex_Hmd ? "HMD" : role == vr::TrackedControllerRole_LeftHand ? "Left" : role == vr::TrackedControllerRole_RightHand ? "Right" : "Tracker " + std::to_string(device);
+            batteries.push_back({name, charge, vr::VRSystem()->GetBoolTrackedDeviceProperty(device, vr::Prop_DeviceIsCharging_Bool)});
+        }
+    }
+    if (!batteries.empty())
+    {
+        card("##XSWristBatteries", battery_y, 100);
+        ImGui::BeginChild("##BatteryList", ImVec2(0,0));
+        for (size_t i=0; i<batteries.size(); ++i)
+        {
+            const auto& battery = batteries[i];
+            if (i % 3) ImGui::SameLine((float)(i%3)*160+8);
+            ImGui::TextColored(battery.charge <= 0.2f ? ImVec4(0.90f,0.64f,0.64f,1) : ImVec4(0.91f,0.93f,0.95f,1), "%s %d%%%s", battery.name.c_str(), (int)(battery.charge*100+0.5f), battery.charging ? "+" : "");
+        }
+        ImGui::EndChild(); ImGui::End();
+    }
+    ImGui::PopStyleVar(4);
+    ImGui::PopStyleColor(8);
+}
