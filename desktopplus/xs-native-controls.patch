+std::vector<int> XSCutPoints(int width, const std::string& layout)
+{
+    if (width < 4) return {};
+    std::vector<int> cuts;
+    if (layout == "Dual") cuts = {0,width/2,width};
+    else if (layout == "Thirds") cuts = {0,width/3,width*2/3,width};
+    else if (layout == "Wide Center") cuts = {0,width/4,width*3/4,width};
+    else if (layout == "Add Full") cuts = {0,width};
+    else if (layout == "Add Left Half") cuts = {0,width/2};
+    else if (layout == "Add Right Half") cuts = {width/2,width};
+    return cuts;
+}
+
+POINT XSCropOrigin(const RECT& monitor, const RECT& adapter, bool combined_ddp)
+{
+    return combined_ddp ? POINT{monitor.left-adapter.left,monitor.top-adapter.top} : POINT{0,0};
+}
+
+struct XSMonitor
+{
+    int ID;
+    RECT Bounds;
+    RECT AdapterBounds;
+    std::string Label;
+};
+
+std::vector<XSMonitor> XSGetMonitors()
+{
+    std::vector<XSMonitor> result;
+    Microsoft::WRL::ComPtr<IDXGIFactory1> factory;
+    if (FAILED(CreateDXGIFactory1(__uuidof(IDXGIFactory1), (void**)&factory))) return result;
+    const bool ignore_virtual = ConfigManager::GetValue(configid_int_interface_wmr_ignore_vscreens) == 1;
+    int id = 0;
+    for (UINT ai=0; ; ++ai)
+    {
+        Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+        if (factory->EnumAdapters(ai, &adapter) == DXGI_ERROR_NOT_FOUND) break;
+        DXGI_ADAPTER_DESC adapter_desc = {}; adapter->GetDesc(&adapter_desc);
+        if (ignore_virtual && wcscmp(adapter_desc.Description, L"Virtual Display Adapter") == 0) continue;
+        const size_t begin = result.size();
+        RECT all = {}; bool have_bounds = false;
+        for (UINT oi=0; ; ++oi, ++id)
+        {
+            Microsoft::WRL::ComPtr<IDXGIOutput> output;
+            if (adapter->EnumOutputs(oi, &output) == DXGI_ERROR_NOT_FOUND) break;
+            DXGI_OUTPUT_DESC desc = {}; if (FAILED(output->GetDesc(&desc))) continue;
+            const RECT rect = desc.DesktopCoordinates;
+            if (!desc.AttachedToDesktop || rect.right <= rect.left || rect.bottom <= rect.top) continue;
+            if (!have_bounds) { all = rect; have_bounds = true; } else ::UnionRect(&all, &all, &rect);
+            const std::string label = "Desktop " + std::to_string(id+1) + " - " + std::to_string(rect.right-rect.left) + "x" + std::to_string(rect.bottom-rect.top);
+            result.push_back({id,rect,{},label});
+        }
+        for (size_t i=begin; i<result.size(); ++i) result[i].AdapterBounds = all;
+    }
+    return result;
+}
+}
