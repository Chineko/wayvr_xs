+void WindowSettings::Show(bool skip_fade)
+{
+    if (!IsVisible() && UIManager::Get()->IsOpenVRLoaded() && !UIManager::Get()->IsInDesktopMode())
+    {
+        const Matrix4 facing = vr::IVRSystemEx::ComputeHMDFacingTransform(1.15f);
+        for (const auto id : {floating_window_ovrl_state_room, floating_window_ovrl_state_dashboard_tab})
+        {
+            auto& state = GetOverlayState(id);
+            state.TransformAbs = facing;
+            state.IsPinned = true;
+            state.Size = 0.70f;
+        }
+    }
+    FloatingWindow::Show(skip_fade);
